{
  "name": "mcp-server-zenmoney",
  "version": "1.0.1",
  "mcpName": "io.github.krax1337/mcp-server-zenmoney",
  "description": "MCP server for ZenMoney (Дзен-мани): accounts, transactions, categories, budgets, reports, debts and planned operations over the official diff API",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zenmoney",
    "zerro",
    "personal-finance"
  ],
  "license": "MIT",
  "author": "Asanali Bulatov",
  "homepage": "https://github.com/krax1337/mcp-server-zenmoney#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krax1337/mcp-server-zenmoney.git"
  },
  "bugs": "https://github.com/krax1337/mcp-server-zenmoney/issues",
  "type": "module",
  "bin": {
    "mcp-server-zenmoney": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
